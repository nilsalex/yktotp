{
  "name": "yktotp",
  "description": "yktotp",
  "version": "0.1.1",
  "manifest_version": 3,
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+T"
      }
    }
  },
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["nativeMessaging", "clipboardWrite"],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@yktotp",
      "scripts": ["background.js"]
    }
  }
}
